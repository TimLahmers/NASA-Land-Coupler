conflict comp mpi

module-whatis	"loads the [module-info name] environment"

set modname     [module-info name]
set modmode     [module-info mode]

module purge
module load compiler/intel/19 openmpi/4.0 LIS/7.3 esmf/8.8
module load cmake/3.20
module load python/3.9
module load git/2.29

set def_nlc_dir $env(NLC_DIR)

set   def_lis_rpc         /usr/lib64/libtirpc.so
set   def_lis_hdf5        /util/opt/hdf5/1.12/intel/19
set   def_lis_netcdf      /util/opt/netcdf/4.7/intel/19
set   def_lis_openjpeg    /util/opt/openjpeg/2.4/intel/19
set   def_lis_eccodes     /util/opt/eccodes/2.24/intel/19.0
set   def_lis_hdf4        /util/opt/hdf4/4.2.15/intel/19
set   def_lis_hdfeos      /util/opt/hdf-eos2/2.20/intel/19
set   def_lis_modesmf     /util/opt/esmf/8.8/intel/19/mod/modO/Linux.intel.64.openmpi.default
set   def_lis_libesmf     /util/opt/esmf/8.8/intel/19/lib/libO/Linux.intel.64.openmpi.default
set   def_lvt_proj        /util/opt
set   def_ldt_libgeotiff  /util/opt/libgeotiff/1.6/intel/19/lib
set   def_lvt_gdal        /util/opt/gdal/3.4/intel/19
set   def_lvt_fortrangis  /util/opt/fortrangis/2.5/intel/19/lib
set   def_lis_petsc       /util/opt
set   def_lis_minpack     /util/opt/minpack/19961126/intel/19/lib
set   def_lis_crtm        /util/opt/crtm/2.0/intel/19
set   def_lis_crtm_prof   /util/opt
set   def_lis_cmem        /util/opt
set   def_lis_lapack      /util/opt/lapack/3.9/intel/19/lib
set   def_wrfhydro_netcdf /util/opt/netcdf/4.7/intel/19
set   def_parflow_hdf5    /util/opt/hdf5/1.12/intel/19
set   def_parflow_hypre   /util/opt
set   def_parflow_silo    /util/opt

setenv   DEV_ENV         LISF_7_INTEL_19_0_8
setenv   LIS_ARCH        linux_ifc
setenv   LIS_SPMD        parallel
setenv   LIS_FC          mpif90
setenv   LIS_CC          mpicc
setenv   LIS_RPC         $def_lis_rpc
setenv   LIS_OPENJPEG    $def_lis_openjpeg
setenv   LIS_ECCODES     $def_lis_eccodes
setenv   LIS_NETCDF      $def_lis_netcdf
setenv   LIS_HDF4        $def_lis_hdf4
setenv   LIS_HDFEOS      $def_lis_hdfeos
setenv   LIS_HDF5        $def_lis_hdf5
setenv   LIS_MODESMF     $def_lis_modesmf
setenv   LIS_LIBESMF     $def_lis_libesmf
setenv   LIS_MINPACK     $def_lis_minpack
setenv   LIS_CRTM        $def_lis_crtm
setenv   LIS_CRTM_PROF   $def_lis_crtm_prof
setenv   LIS_CMEM        $def_lis_cmem
setenv   LIS_LAPACK      $def_lis_lapack
setenv   LIS_PETSC       $def_lis_petsc

setenv   LDT_ARCH        linux_ifc
setenv   LDT_FC          mpiifort
setenv   LDT_CC          mpicc
setenv   LDT_RPC         $def_lis_rpc
setenv   LDT_OPENJPEG    $def_lis_openjpeg
